{
  "version": 2,
  "builds": [
    {
      "src": "src/claritydocs/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "src/claritydocs/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/src/claritydocs/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/src/claritydocs/main.py"
    },
    {
      "src": "/docs",
      "dest": "/src/claritydocs/main.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/src/claritydocs/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/src/claritydocs/static/index.html"
    }
  ]
}
